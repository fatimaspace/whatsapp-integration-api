{
  "development": {
    "DATABASE_PROVIDER": "postgresql",
    "LOG_LEVEL": "debug",
    "NODE_ENV": "development",
    "CORS_ORIGIN": "*",
    "CACHE_REDIS_ENABLED": "false"
  },
  "staging": {
    "DATABASE_PROVIDER": "postgresql",
    "LOG_LEVEL": "info",
    "NODE_ENV": "staging",
    "CORS_ORIGIN": "https://staging.example.com",
    "CACHE_REDIS_ENABLED": "true"
  },
  "production": {
    "DATABASE_PROVIDER": "postgresql",
    "LOG_LEVEL": "error",
    "NODE_ENV": "production",
    "CORS_ORIGIN": "https://production.example.com",
    "CACHE_REDIS_ENABLED": "true"
  },
  "requiredSecrets": [
    "DATABASE_URL",
    "AUTHENTICATION_API_KEY",
    "REDIS_URI"
  ],
  "optionalSecrets": [
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "RABBITMQ_URI",
    "OPENAI_API_KEY"
  ]
}
